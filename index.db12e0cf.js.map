"use strict";
var thumbs = document.getElementById("thumbs");
var mainImage = document.getElementById("largeImg");
thumbs.addEventListener("click", function(e) {
    e.preventDefault();
    var element = e.target.closest(".list-item__link");
    if (!element) return;
    var imageUrl = element.href;
    mainImage.src = imageUrl;
});

